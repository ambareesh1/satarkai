# SatarkAI configuration — copy to `.env` and fill what you need.
# Everything here is OPTIONAL. The app runs fully without any keys.

# ---- Smarter text verdicts (optional) ----
# LLM reasoning + explanations via OpenRouter. Without it, the rule engine is used.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Realistic voices for the call simulator (optional) ----
# ElevenLabs text-to-speech. Without it, the browser's free Web Speech voice is used.
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # default "Rachel"

# ---- Daily spam report email (optional) ----
# Uses SMTP to email the daily report. Gmail: create an App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_app_password
# REPORT_TO=you@gmail.com
